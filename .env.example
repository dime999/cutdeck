# ── Osnovno ────────────────────────────────────────────────
PORT=3000
# Adresa na kojoj otvaraš aplikaciju.
BASE_URL=http://localhost:3000
APP_NAME=CutDeck

# Kod koji prijatelji unose pri registraciji. Ostavi prazno = registracija zatvorena
# za sve osim prvog korisnika (tebe).
INVITE_CODE=

# Email koji se prikazuje u politici privatnosti.
CONTACT_EMAIL=

# ── Snimci i Shorts ────────────────────────────────────────
# Folder u koji kopiraš snimke gameplaya. Prazno = data/recordings unutar aplikacije.
RECORDINGS_DIR=
# Putanje do ffmpeg i ffprobe ako nisu u PATH-u (npr. C:\ffmpeg\bin\ffmpeg.exe).
FFMPEG_PATH=
FFPROBE_PATH=

# ── Tajni ključ ────────────────────────────────────────────
# Aplikacija ga sama generiše pri prvom pokretanju. Njime se potpisuju prijave.
SESSION_SECRET=
