# ── Osnovno ────────────────────────────────────────────────
PORT=3000
# Adresa na kojoj otvaraš aplikaciju.
BASE_URL=http://localhost:3000
APP_NAME=CutDeck

# Aplikacija nema prijavu i zato se javlja samo na ovom računaru (127.0.0.1).
# Ne mijenjaj ovo osim ako znaš da je mreža sigurna: ko god dođe do adrese,
# vidi tvoje snimke i može rezati i brisati Shorts.
HOST=127.0.0.1

# Email koji se prikazuje u politici privatnosti.
CONTACT_EMAIL=

# ── Snimci i Shorts ────────────────────────────────────────
# Folder u koji kopiraš snimke gameplaya. Prazno = data/recordings unutar aplikacije.
RECORDINGS_DIR=
# Putanje do ffmpeg i ffprobe ako nisu u PATH-u (npr. C:\ffmpeg\bin\ffmpeg.exe).
FFMPEG_PATH=
FFPROBE_PATH=

# ── Titlovi ────────────────────────────────────────────────
# Model za prepoznavanje engleskog govora. Prazno = data/models/ggml-small.en.bin (vidi README).
WHISPER_MODEL=
