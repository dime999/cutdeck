# ── Osnovno ────────────────────────────────────────────────
PORT=3000
# Adresa na kojoj otvaraš aplikaciju. Mora se poklapati sa
# "Authorized redirect URI" u Google Cloud konzoli (+ /oauth/youtube/callback).
BASE_URL=http://localhost:3000
APP_NAME=MultiPost

# Kod koji prijatelji unose pri registraciji. Ostavi prazno = registracija zatvorena
# za sve osim prvog korisnika (tebe).
INVITE_CODE=

# Email koji se prikazuje u politici privatnosti (treba za Google audit).
CONTACT_EMAIL=

# ── Google / YouTube ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postavi na true tek kad Google odobri audit tvog projekta.
YT_PROJECT_AUDITED=false

# Koliko videa se istovremeno šalje na YouTube.
UPLOAD_CONCURRENCY=2

# ── Tajni ključevi ─────────────────────────────────────────
# Aplikacija ih sama generiše pri prvom pokretanju. NE MIJENJAJ ENCRYPTION_KEY
# nakon što povežeš kanale – sačuvani pristupi se više ne bi mogli pročitati.
SESSION_SECRET=
ENCRYPTION_KEY=
